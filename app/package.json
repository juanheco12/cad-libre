{
  "name": "cad-libre",
  "version": "1.3.0",
  "description": "Visor DWG y exportador a DXF con preservación total de georreferenciación",
  "main": "out/main/index.js",
  "author": "Juan Hernandez",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/juanheco12/cad-libre.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "icono": "electron scripts/generar-icono.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.juanhernandez.cadlibre",
    "productName": "CAD LIBRE",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "CAD LIBRE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "CAD-LIBRE-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "juanheco12",
        "repo": "cad-libre",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../build_motor/dist/cadlibre-motor",
        "to": "motor"
      }
    ]
  }
}
