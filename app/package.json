{
  "name": "cad-libre",
  "version": "1.1.0",
  "description": "Visor DWG y exportador a DXF con preservación total de georreferenciación",
  "main": "out/main/index.js",
  "author": "Juan Hernandez",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.juanhernandez.cadlibre",
    "productName": "CAD LIBRE",
    "win": {
      "target": "nsis"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../build_motor/dist/cadlibre-motor",
        "to": "motor"
      }
    ]
  }
}
